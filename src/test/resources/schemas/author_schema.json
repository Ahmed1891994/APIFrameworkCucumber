{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthorEntity",
  "type": "object",
  "properties": {
    "id": { "type": "integer" },
    "name": { "type": "string" },
    "age": { "type": "integer" },
    "active": { "type": "boolean" },
    "rating": { "type": ["number", "null"] },
    "totalBooks": { "type": ["integer", "null"] },
    "genres": { "type": ["array", "null"], "items": { "type": "string" } },
    "scores": { "type": ["array", "null"], "items": { "type": "integer" } },
    "wealth": { "type": ["number", "null"] },
    "followers": { "type": ["integer", "null"] }
  },
  "required": ["id", "name", "age"]
}
