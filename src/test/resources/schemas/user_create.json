{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "job", "id", "createdAt"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "job": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}